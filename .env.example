# Скопируйте в .env и при необходимости измените значения
DB_NAME=autoparts
DB_USERNAME=autoparts
DB_PASSWORD=autoparts

# Секрет подписи JWT — не короче 32 символов. Обязательно смените для любого не-учебного окружения!
JWT_SECRET=dev-only-secret-change-me-please-0123456789abcdef

CORS_ALLOWED_ORIGINS=http://localhost:4200
SEED_DEMO_USERS=true

# Порты на хост-машине
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=4200
